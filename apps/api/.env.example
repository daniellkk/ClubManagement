# Local development — Docker Postgres from docker-compose.yml
DATABASE_URL="postgresql://club:club_dev_password@localhost:5432/clubmanagement?schema=public"
PORT=3000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Where the browser is sent back after Google login
ADMIN_APP_URL=http://localhost:5173

# ── Google OAuth (console.cloud.google.com → APIs & Services → Credentials) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Firebase Authentication (Google popup via Firebase).
# FIREBASE_WEB_CONFIG: paste the firebaseConfig object from Firebase console > Project settings > Your apps > SDK setup,
# on ONE line inside single quotes, e.g. FIREBASE_WEB_CONFIG='{ apiKey: "AIza...", authDomain: "x.firebaseapp.com", projectId: "x", ... }'
# That alone enables Google sign-in. FIREBASE_SERVICE_ACCOUNT (service-account JSON inline or a file path) is optional.
FIREBASE_WEB_CONFIG=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# InforU messaging gateway (SMS / WhatsApp / Umail) for campaigns — https://capi.inforu.co.il/api/v2
# Real sends need INFORU_USERNAME + INFORU_API_TOKEN AND INFORU_DRY_RUN=false; otherwise every campaign run is simulated.
INFORU_USERNAME=
INFORU_API_TOKEN=
INFORU_SENDER=HapoelBS
INFORU_DRY_RUN=true
INFORU_OPT_OUT_TEXT=
INFORU_EMAIL_FROM=
INFORU_EMAIL_FROM_NAME=
